# Copy this file to .env and fill in the values: cp .env.example .env

# --- Database (PostgreSQL) ---
# Used by compose.yaml / compose.prod.yaml and drizzle.config.ts
DB_HOST=localhost
DB_PORT=5432
DB_USER=shiftly
DB_PASSWORD=change-me
DB_NAME=shiftly
# Used by the app (lib/db.ts) and the seed script. Must match the values above.
DB_URL=postgres://shiftly:change-me@localhost:5432/shiftly

# --- Auth (better-auth) ---
# Public URL the app is served from (used by lib/auth.ts)
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Superadmin seed (bun run db:seed) ---
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me
